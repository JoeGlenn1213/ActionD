{
  "apiVersion": "actiond.dev/v1",
  "id": "affected-scope",
  "name": "affected_scope",
  "version": "1.0.0",
  "description": "Analyze git changes to determine affected modules, languages and downstream impact",
  "command": "python3",
  "args": ["run.py"],
  "triggers": ["git.push"],
  "languages": ["*"],
  "timeout": "2m",
  "artifacts": ["affected-scope.json"],
  "capability": "utility",
  "owner_layer": "core",
  "maturity": "stable",
  "status": "enabled",
  "supported_profiles": ["fast", "full", "release"],
  "inputs": {
    "repo": "string",
    "branch": "string",
    "commit_sha": "string",
    "diff": "string"
  },
  "outputs": {
    "affected-scope.json": "JSON report of affected modules"
  }
}
