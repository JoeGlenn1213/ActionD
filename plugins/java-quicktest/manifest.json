{
  "apiVersion": "actiond.dev/v1",
  "id": "java-quicktest",
  "name": "java-quicktest",
  "version": "1.0.0",
  "description": "Run fast Java unit tests",
  "command": "python3",
  "args": ["run.py"],
  "triggers": ["git.push"],
  "languages": ["java"],
  "timeout": "5m",
  "artifacts": ["test-report.json"],
  "capability": "test",
  "owner_layer": "optional",
  "maturity": "stable",
  "status": "enabled",
  "supported_profiles": ["fast", "full"],
  "inputs": {
    "repo": "string"
  },
  "outputs": {
    "test-report.json": "Test results"
  }
}
